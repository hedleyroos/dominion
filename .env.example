# Copy this file to .env and fill in the values.

SECRET_KEY=replace-me-with-a-long-random-secret-key

# Set to False in production.
DEBUG=True

DATABASE_URL=sqlite:///db.sqlite3

MEDIA_ROOT=/var/app/media
STATIC_ROOT=/var/app/static

# Email backend — see dominion.mail.backends for options.
EMAIL_BACKEND=dominion.mail.backends.CeleryFileBackend

AWS_ACCESS_KEY_ID=YOUR-ACCESS-KEY-ID
AWS_SECRET_ACCESS_KEY=YOUR-SECRET-ACCESS-KEY

# Memcached — used for rate limiting cache and sessions in production (DEBUG=False).
MEMCACHED_LOCATION=localhost:11211
MEMCACHED_KEY_PREFIX=dominion

CELERY_BROKER=amqp://guest:guest@localhost:5672//
CELERY_BACKEND=redis://localhost:6379/3
